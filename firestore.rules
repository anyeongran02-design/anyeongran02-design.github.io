rules_version = '2';
// 봉화군지역사회보장협의체 자유게시판 보안 규칙
// Firebase 콘솔 → Firestore Database → 규칙 탭에 이 내용을 그대로 붙여 넣고 '게시'를 누르세요.
// 관리자 지정: Firestore에 'admins' 컬렉션을 만들고, 관리자 계정의 UID를 문서 ID로 하는 빈 문서를 추가하세요.
service cloud.firestore {
  match /databases/{database}/documents {

    function member() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    function admin() {
      return request.auth != null && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    function text(v, min, max) {
      return v is string && v.size() >= min && v.size() <= max;
    }

    // 관리자 여부는 본인만 확인할 수 있음. 추가·삭제는 콘솔에서만.
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    match /posts/{postId} {
      allow read: if true;

      allow create: if member()
        && request.resource.data.keys().hasOnly(['title', 'body', 'uid', 'name', 'createdAt', 'updatedAt', 'commentCount'])
        && request.resource.data.uid == request.auth.uid
        && text(request.resource.data.title, 1, 100)
        && text(request.resource.data.body, 1, 5000)
        && text(request.resource.data.name, 1, 20)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.commentCount == 0;

      allow update: if member() && (
          // 글쓴이가 제목·내용 고치기
          (resource.data.uid == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title', 'body', 'updatedAt'])
            && text(request.resource.data.title, 1, 100)
            && text(request.resource.data.body, 1, 5000)
            && request.resource.data.updatedAt == request.time)
          ||
          // 댓글 수 1씩 늘리고 줄이기
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['commentCount'])
            && (request.resource.data.commentCount == resource.data.commentCount + 1
             || request.resource.data.commentCount == resource.data.commentCount - 1))
        );

      allow delete: if request.auth != null && (resource.data.uid == request.auth.uid || admin());

      match /comments/{commentId} {
        allow read: if true;

        allow create: if member()
          && request.resource.data.keys().hasOnly(['body', 'uid', 'name', 'createdAt'])
          && request.resource.data.uid == request.auth.uid
          && text(request.resource.data.body, 1, 1000)
          && text(request.resource.data.name, 1, 20)
          && request.resource.data.createdAt == request.time;

        // 댓글 쓴이, 원글 쓴이(글 삭제 때 댓글 정리), 관리자
        allow delete: if request.auth != null && (
          resource.data.uid == request.auth.uid
          || admin()
          || get(/databases/$(database)/documents/posts/$(postId)).data.uid == request.auth.uid);
      }
    }
  }
}
